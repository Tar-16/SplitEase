rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // SECURITY HOLD: history-derived settlement ceilings are not Rules-enforced.
    // Financial writes are demo-only. Never broaden/remove this audience gate
    // without a reviewed server-enforceable ledger design. This is not debt validation.
    // Real Firestore verifies ID-token audience against its project; a production
    // project's valid token cannot carry this demo project's reserved audience.
    function demoFinancialWritesOnly() {
      return signedIn() && request.auth.token.aud == 'demo-splitease-auth';
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(display, normalized) {
      return display is string && normalized is string
        && display.matches('[A-Za-z0-9_]{3,30}') && normalized == display.lower();
    }
    function validProfile(p, uid) {
      return p.keys().hasAll(['uid','normalizedUsername','displayUsername','email','upiId','createdAt','updatedAt'])
        && p.keys().hasOnly(['uid','normalizedUsername','displayUsername','email','upiId','createdAt','updatedAt'])
        && p.uid == uid && validName(p.displayUsername,p.normalizedUsername)
        && p.email is string && p.email == request.auth.token.email.lower()
        && (p.upiId == null || (p.upiId is string && p.upiId.size() <= 100 && p.upiId.matches('[A-Za-z0-9._-]+@[A-Za-z0-9.-]+')))
        && p.createdAt is timestamp && p.updatedAt == request.time;
    }
    function pairedRegistry(p, uid) {
      let r = getAfter(/databases/$(database)/documents/usernames/$(p.normalizedUsername)).data;
      let u = getAfter(/databases/$(database)/documents/publicIdentities/$(uid)).data;
      return r.uid == uid && r.displayUsername == p.displayUsername
        && u.uid == uid && u.normalizedUsername == p.normalizedUsername && u.displayUsername == p.displayUsername;
    }
    match /profiles/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && validProfile(request.resource.data,uid)
        && request.resource.data.createdAt == request.time && pairedRegistry(request.resource.data,uid);
      allow update: if owner(uid) && validProfile(request.resource.data,uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayUsername','upiId','updatedAt'])
        && pairedRegistry(request.resource.data,uid);
      allow list, delete: if false;
    }
    match /usernames/{name} {
      // Exact key lookup only; no email, UPI or private metadata in this document.
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['uid','displayUsername'])
        && request.resource.data.keys().hasOnly(['uid','displayUsername'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.displayUsername,name)
        && (!exists(/databases/$(database)/documents/usernames/$(name)) || resource.data.uid == request.auth.uid)
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.normalizedUsername == name
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayUsername == request.resource.data.displayUsername;
      allow list, delete: if false;
    }
    match /publicIdentities/{uid} {
      allow get: if signedIn();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['uid','normalizedUsername','displayUsername'])
        && request.resource.data.keys().hasOnly(['uid','normalizedUsername','displayUsername'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.displayUsername,request.resource.data.normalizedUsername)
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.normalizedUsername == request.resource.data.normalizedUsername
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.displayUsername == request.resource.data.displayUsername;
      allow list, delete: if false;
    }
    function groupShape(p) {
      return p.keys().hasAll(['name','type','creatorId','adminId','createdAt','updatedAt','revision','memberIds','members'])
        && p.keys().hasOnly(['name','type','creatorId','adminId','createdAt','updatedAt','revision','memberIds','members','financialRevision','financialRecord'])
        && p.name is string && p.name.size() > 0 && p.name.size() <= 100 && p.name.matches('(?s).*[^ \t\r\n].*')
        && p.type in ['FLAT','TRIP'] && p.creatorId is string && p.adminId is string
        && p.createdAt is timestamp && p.updatedAt == request.time && p.revision is int
        && p.memberIds is list && p.members is map && p.memberIds.size() > 0
        && p.memberIds.toSet().size() == p.memberIds.size()
        && p.members.keys().hasAll(p.memberIds) && p.adminId in p.memberIds;
    }
    function memberShape(m) {
      return m is map && m.keys().hasAll(['username','status','joinedAt','leftAt'])
        && m.keys().hasOnly(['username','status','joinedAt','leftAt'])
        && m.username is string && m.status == 'ACTIVE' && m.joinedAt is timestamp
        && (m.leftAt == null || m.leftAt is timestamp);
    }
    function registeredMember(uid,m) {
      let identity = get(/databases/$(database)/documents/publicIdentities/$(uid)).data;
      return uid is string && memberShape(m) && identity.uid == uid && identity.displayUsername == m.username;
    }
    function initialAt(p,i) {
      let uid = p.memberIds[i];
      let row = p.members[uid];
      let identity = get(/databases/$(database)/documents/publicIdentities/$(uid)).data;
      // Exact map equality validates keys/types/values without repeating a schema per initial row.
      return uid is string && identity.uid == uid && row == {
        'username':identity.displayUsername, 'status':'ACTIVE', 'joinedAt':request.time, 'leftAt':null
      };
    }
    function initialMember(p,i) { return p.memberIds.size() <= i || initialAt(p,i); }
    function createGroup(p) {
      // Eight initial members keep per-write rule access below ten. Later adds validate one member.
      return !p.keys().hasAny(['financialRevision','financialRecord']) && groupShape(p) && p.creatorId == request.auth.uid && p.adminId == request.auth.uid
        && p.createdAt == request.time && p.revision == 1 && p.memberIds.size() <= 8
        && p.members.size() == p.memberIds.size()
        && initialMember(p,0) && initialMember(p,1) && initialMember(p,2) && initialMember(p,3)
        && initialMember(p,4) && initialMember(p,5) && initialMember(p,6) && initialMember(p,7);
    }
    function validJoin(p,old,uid) {
      return p.members.diff(old.members).affectedKeys() == [uid].toSet()
        && registeredMember(uid,p.members[uid])
        && ((!(uid in old.members) && p.members[uid].joinedAt == request.time && p.members[uid].leftAt == null)
          || (uid in old.members && old.members[uid].status == 'LEFT'
            && p.members[uid].joinedAt == old.members[uid].joinedAt && p.members[uid].leftAt == old.members[uid].leftAt));
    }
    function addOne(p,old) {
      let added = p.memberIds.removeAll(old.memberIds);
      return p.adminId == old.adminId && p.name == old.name && p.type == old.type
        && added.size() == 1 && p.memberIds.size() == old.memberIds.size()+1
        && p.memberIds.hasAll(old.memberIds) && validJoin(p,old,added[0]);
    }
    function modifyGroup(p,old) {
      return !p.diff(old).affectedKeys().hasAny(['financialRevision','financialRecord']) && groupShape(p) && p.creatorId == old.creatorId && p.createdAt == old.createdAt
        && p.revision == old.revision+1
        && ((p.members == old.members && p.memberIds == old.memberIds
            && ((p.name == old.name && p.type == old.type && p.adminId in old.memberIds)
              || (p.adminId == old.adminId)))
          || addOne(p,old));
      // No leave/remove/delete branch: cloud financial eligibility is unavailable until 9E.
    }
    function financialGroupChange(p,old,id) {
      let record=getAfter(/databases/$(database)/documents/$(p.financialRecord.collection)/$(p.financialRecord.id)).data;
      return demoFinancialWritesOnly() && request.auth.uid in old.memberIds
        && p.diff(old).affectedKeys().hasOnly(['financialRevision','financialRecord'])
        && p.financialRevision is int && p.financialRevision==old.get('financialRevision',0)+1
        && p.financialRecord.keys().hasAll(['collection','id']) && p.financialRecord.keys().hasOnly(['collection','id'])
        && p.financialRecord.collection in ['expenses','settlements']
        && record.groupId==id && record.financialVersion==p.financialRevision;
    }
    function fencedFinancial(p,kind,id) {
      let before=get(/databases/$(database)/documents/groups/$(p.groupId)).data;
      let after=getAfter(/databases/$(database)/documents/groups/$(p.groupId)).data;
      return demoFinancialWritesOnly() && p.financialVersion is int && p.financialVersion==before.get('financialRevision',0)+1
        && after.financialRevision==p.financialVersion && after.financialRecord=={'collection':kind,'id':id};
    }
    match /groups/{groupId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/groups/$(groupId)) || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && groupId.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}') && createGroup(request.resource.data);
      allow update: if signedIn() && ((request.auth.uid == resource.data.adminId
        && request.auth.uid in resource.data.memberIds && modifyGroup(request.resource.data,resource.data))
        || financialGroupChange(request.resource.data,resource.data,groupId));
      allow delete: if false;
    }
    function expenseMember(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    function expenseRow(ids,shares,base,remainder,i) {
      let uid=ids[i];
      let share=shares[uid];
      return uid is string && (i == 0 || ids[i-1] < uid)
        && share is int && share == base + (i < remainder ? 1 : 0);
    }
    function expenseAt(ids,shares,n,base,remainder,i) { return n <= i || expenseRow(ids,shares,base,remainder,i); }
    function expenseShape(p,old) {
      let g=get(/databases/$(database)/documents/groups/$(p.groupId)).data;
      let n=p.participants.size();
      let base=int(p.amountPaise / n);
      let remainder=p.amountPaise % n;
      let allowed=g.memberIds.toSet().union(old.get('participants',[]).toSet());
      return p.keys().hasAll(['groupId','title','description','amountPaise','payerId','creatorId','category','expenseDate','participants','shares','revision','deleted','createdAt','updatedAt','financialVersion'])
        && p.keys().hasOnly(['groupId','title','description','amountPaise','payerId','creatorId','category','expenseDate','participants','shares','revision','deleted','createdAt','updatedAt','financialVersion'])
        && request.auth.uid in g.memberIds && g.type in ['FLAT','TRIP']
        && p.title is string && p.title.size()>0 && p.title.size()<=200 && p.title.matches('(?s).*[^ \t\r\n].*')
        && p.description is string && p.description.size()<=2000
        && p.amountPaise is int && p.amountPaise>0 && p.amountPaise<=1000000000000
        && p.expenseDate is int && p.expenseDate>=0
        && p.category in ['Food','Travel','Rent','Bills','Other']
        && p.payerId is string && p.payerId in g.members
        && (p.payerId in g.memberIds || ('payerId' in old && p.payerId == old.payerId))
        && p.creatorId is string && p.creatorId in g.members
        && p.participants is list && p.participants.size()>0 && p.participants.size()<=8
        && p.participants.toSet().size()==n && allowed.hasAll(p.participants) && g.members.keys().hasAll(p.participants)
        && p.shares is map && p.shares.keys().toSet()==p.participants.toSet()
        && p.revision is int && p.revision>0 && p.deleted == false
        && p.createdAt is timestamp && p.updatedAt == request.time
        && expenseAt(p.participants,p.shares,n,base,remainder,0) && expenseAt(p.participants,p.shares,n,base,remainder,1) && expenseAt(p.participants,p.shares,n,base,remainder,2) && expenseAt(p.participants,p.shares,n,base,remainder,3)
        && expenseAt(p.participants,p.shares,n,base,remainder,4) && expenseAt(p.participants,p.shares,n,base,remainder,5) && expenseAt(p.participants,p.shares,n,base,remainder,6) && expenseAt(p.participants,p.shares,n,base,remainder,7);
    }
    match /expenses/{expenseId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/expenses/$(expenseId)) || expenseMember(resource.data.groupId));
      allow list: if expenseMember(resource.data.groupId);
      allow create: if signedIn() && expenseId.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && fencedFinancial(request.resource.data,'expenses',expenseId) && expenseShape(request.resource.data,{}) && request.resource.data.creatorId==request.auth.uid
        && request.resource.data.revision==1 && request.resource.data.createdAt==request.time;
      allow update: if expenseMember(resource.data.groupId) && fencedFinancial(request.resource.data,'expenses',expenseId) && resource.data.deleted == false
        && request.resource.data.groupId==resource.data.groupId && request.resource.data.creatorId==resource.data.creatorId
        && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.updatedAt==request.time
        && request.resource.data.revision is int && request.resource.data.revision==resource.data.revision+1
        && ((request.resource.data.deleted==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','revision','updatedAt','financialVersion']))
          || expenseShape(request.resource.data,resource.data));
      allow delete: if false;
    }
    function settlementShape(p) {
      let group=get(/databases/$(database)/documents/groups/$(p.groupId)).data;
      return p.keys().hasAll(['groupId','payerId','payeeId','amountPaise','settlementDate','revision','financialVersion','recordedBy','createdAt','updatedAt'])
        && p.keys().hasOnly(['groupId','payerId','payeeId','amountPaise','settlementDate','revision','financialVersion','recordedBy','createdAt','updatedAt'])
        && request.auth.uid in group.memberIds
        && p.payerId is string && p.payeeId is string && p.payerId!=p.payeeId
        && p.payerId in group.members && p.payeeId in group.members
        && p.recordedBy is string && p.recordedBy in group.members
        && p.amountPaise is int && p.amountPaise>0 && p.amountPaise<=1000000000000
        && p.settlementDate is int && p.settlementDate>=0
        && p.revision is int && p.revision>0 && p.createdAt is timestamp && p.updatedAt==request.time;
    }
    match /settlements/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/settlements/$(id)) || expenseMember(resource.data.groupId));
      allow list: if expenseMember(resource.data.groupId);
      allow create: if signedIn() && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && settlementShape(request.resource.data) && fencedFinancial(request.resource.data,'settlements',id)
        && request.auth.uid in [request.resource.data.payerId,request.resource.data.payeeId]
        && request.resource.data.recordedBy==request.auth.uid && request.resource.data.revision==1 && request.resource.data.createdAt==request.time;
      allow update: if signedIn() && settlementShape(request.resource.data) && fencedFinancial(request.resource.data,'settlements',id)
        && request.resource.data.revision==resource.data.revision+1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaise','settlementDate','revision','financialVersion','updatedAt']);
      allow delete: if false;
    }
    // Recurring is a separate demo-only document tree. No accounting writes or fences.
    function recurringDemo() {
      return signedIn() && request.auth.token.aud == 'demo-splitease-auth';
    }
    function recurringMonth() { return request.time.year() * 12 + request.time.month() - 1; }
    function recurringBill(id) {
      return get(/databases/$(database)/documents/recurringBills/$(id)).data;
    }
    function recurringAccess(groupId) { return recurringDemo() && expenseMember(groupId); }
    function recurringTemplate(p) {
      let ids = p.participants;
      let n = ids.size();
      let base = int(p.amountPaise / n);
      let remainder = p.amountPaise % n;
      let members = get(/databases/$(database)/documents/groups/$(p.groupId)).data.memberIds;
      return p.keys().hasOnly(['groupId','title','amountPaise','handlerId','participants','shares',
          'dueDay','reminderLeadDays','active','nextMonth','revision'])
        && p.title is string && p.title.size() <= 200 && p.title.matches('(?s).*[^ \t\r\n].*')
        && p.amountPaise is int && p.amountPaise > 0 && p.amountPaise <= 1000000000000
        && p.dueDay is int && p.dueDay >= 1 && p.dueDay <= 31
        && p.reminderLeadDays is int && p.reminderLeadDays >= 0 && p.reminderLeadDays <= 31
        && p.active is bool && p.nextMonth is int && p.revision is int
        && ids is list && n > 0 && n <= 8 && p.handlerId is string && p.handlerId in members
        && members.toSet().hasAll(ids) && p.shares is map && p.shares.keys().toSet() == ids.toSet()
        && expenseAt(ids,p.shares,n,base,remainder,0) && expenseAt(ids,p.shares,n,base,remainder,1)
        && expenseAt(ids,p.shares,n,base,remainder,2) && expenseAt(ids,p.shares,n,base,remainder,3)
        && expenseAt(ids,p.shares,n,base,remainder,4) && expenseAt(ids,p.shares,n,base,remainder,5)
        && expenseAt(ids,p.shares,n,base,remainder,6) && expenseAt(ids,p.shares,n,base,remainder,7);
    }
    function recurringAdvance(id,p,b) {
      let key = string(b.nextMonth);
      let cyclePath = /databases/$(database)/documents/recurringBills/$(id)/cycles/$(key);
      return b.active && b.nextMonth <= recurringMonth() && p.nextMonth is int
        && p.nextMonth == b.nextMonth + 1 && p.diff(b).affectedKeys().hasOnly(['nextMonth'])
        && !exists(cyclePath) && getAfter(cyclePath).data.month == b.nextMonth;
    }
    function recurringEdit(p,b) {
      return p.groupId == b.groupId && p.revision == b.revision + 1
        && (!b.active || b.nextMonth > recurringMonth())
        && p.nextMonth == (!b.active && p.active && b.nextMonth < recurringMonth() ? recurringMonth() : b.nextMonth)
        && recurringTemplate(p);
    }
    function recurringCycleCreate(id,key,p,b) {
      let after = getAfter(/databases/$(database)/documents/recurringBills/$(id)).data;
      let members = get(/databases/$(database)/documents/groups/$(b.groupId)).data.memberIds;
      return b.active && b.nextMonth <= recurringMonth() && key == string(b.nextMonth)
        && after.nextMonth == b.nextMonth + 1 && after.diff(b).affectedKeys().hasOnly(['nextMonth'])
        && b.handlerId in members && members.toSet().hasAll(b.participants)
        && p == {'month':b.nextMonth,'amountPaise':b.amountPaise,'handlerId':b.handlerId,
                 'dueDay':b.dueDay,'participants':b.participants,'paid':[]}
        && p.month is int && p.amountPaise is int && p.dueDay is int;
    }
    function recurringStatus(p,b) {
      let before = b.paid.toSet();
      let after = p.paid.toSet();
      return p.diff(b).affectedKeys().hasOnly(['paid'])
        && p.paid is list && p.paid.size() == after.size()
        && b.participants.toSet().hasAll(after)
        && before.difference(after).size() + after.difference(before).size() <= 1;
    }
    match /recurringBills/{id} {
      allow get: if recurringDemo() && (!exists(/databases/$(database)/documents/recurringBills/$(id))
        || expenseMember(resource.data.groupId));
      allow list: if recurringAccess(resource.data.groupId);
      allow create: if recurringAccess(request.resource.data.groupId)
        && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && request.resource.data.revision == 1 && request.resource.data.nextMonth == recurringMonth()
        && recurringTemplate(request.resource.data);
      allow update: if recurringAccess(resource.data.groupId)
        && (recurringAdvance(id,request.resource.data,resource.data) || recurringEdit(request.resource.data,resource.data));
      allow delete: if false;
      match /cycles/{key} {
        allow read: if recurringAccess(recurringBill(id).groupId);
        allow create: if recurringAccess(recurringBill(id).groupId)
          && recurringCycleCreate(id,key,request.resource.data,recurringBill(id));
        allow update: if recurringAccess(recurringBill(id).groupId)
          && recurringStatus(request.resource.data,resource.data);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
