<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Widget.SplitEase.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
    <LinearLayout android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/category_icon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_category" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_details" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
        <TextView android:id="@+id/payer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_payer" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <TextView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_amount" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
        <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_participants" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <TextView android:id="@+id/share" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_preview_hint" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_open"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
