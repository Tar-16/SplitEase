<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical" android:focusableInTouchMode="true"><TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/profile_heading" android:textAppearance="@style/TextAppearance.SplitEase.Title" /><TextView android:id="@+id/account_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/profile_account" android:textAppearance="@style/TextAppearance.SplitEase.Body" /><com.google.android.material.card.MaterialCardView style="@style/Widget.SplitEase.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/username_label" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle" /><TextView android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/email_label" android:textAppearance="@style/TextAppearance.SplitEase.Body" /><com.google.android.material.textfield.TextInputLayout android:id="@+id/upi_layout" style="@style/Widget.SplitEase.Input"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
    android:hint="@string/upi_label" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/upi"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:inputType="text" android:imeOptions="actionDone" android:maxLines="1"
        
        android:autofillHints="" />
</com.google.android.material.textfield.TextInputLayout><TextView android:id="@+id/upi_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/profile_empty_upi" android:textAppearance="@style/TextAppearance.SplitEase.Body" /><TextView android:id="@+id/upi_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/upi_note" android:textAppearance="@style/TextAppearance.SplitEase.Body" /><TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/auth_storage" android:textAppearance="@style/TextAppearance.SplitEase.Body" android:textColor="?attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="polite"/><TextView android:id="@+id/saved" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/profile_saved" android:textAppearance="@style/TextAppearance.SplitEase.Body" android:visibility="gone" android:accessibilityLiveRegion="polite"/><com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:indeterminate="true" android:contentDescription="@string/working" android:visibility="gone" /><com.google.android.material.button.MaterialButton android:id="@+id/save_upi" 
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
