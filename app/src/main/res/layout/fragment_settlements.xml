<?xml version="1.0" ?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_back" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settle_up" android:textAppearance="@style/TextAppearance.SplitEase.Title"/>
        <TextView android:id="@+id/intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_intro" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal"/>
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_error" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_refresh" android:layout_marginTop="12dp"/>
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/parties" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settle_up" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
                <TextView android:id="@+id/kind" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_suggestions" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
                <TextView android:id="@+id/limit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_limit" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
                <TextView android:id="@+id/upi_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/upi_missing" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/pay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/upi_chooser" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/upi_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/upi_notice" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
                <TextView android:id="@+id/edit_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_edit_note" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.SplitEase.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/settlement_record_amount">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:saveEnabled="false" android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settle_up" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/party_only" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_party_only" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/record" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settlement_record" android:layout_marginTop="12dp"/>
            </LinearLayout>
            <TextView android:id="@+id/suggestions_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_suggestions" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_empty" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
            <LinearLayout android:id="@+id/suggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/records_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_records" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <TextView android:id="@+id/no_records" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settlement_no_records" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
            <LinearLayout android:id="@+id/records" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
