<?xml version="1.0" ?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Back" android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_back"/>
        <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_details" android:textAppearance="@style/TextAppearance.SplitEase.Title"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal"/>
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_load_error" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_refresh"/>
        <com.example.splitease.ui.widget.GlassCardView style="@style/Widget.SplitEase.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"><LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.SplitEase.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/expense_title">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/expense_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:saveEnabled="false" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.SplitEase.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/expense_amount">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/expense_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:saveEnabled="false" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/expense_description_layout" style="@style/Widget.SplitEase.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/expense_description" android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/expense_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLength="2000" android:saveEnabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/payer_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_payer" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <Spinner android:id="@+id/payer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false"/>
            <TextView android:id="@+id/category_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_category" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <Spinner android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_details"/>
            <TextView android:id="@+id/participants_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_participants" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <LinearLayout android:id="@+id/participants" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/preview_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_preview_title" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <TextView android:id="@+id/shares" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_preview_hint" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
            <TextView android:id="@+id/receipt_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/bills_title" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <TextView android:id="@+id/receipt_device_only" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/receipt_device_only" android:textAppearance="@style/TextAppearance.SplitEase.Body" android:visibility="gone"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/bills_summary" style="@style/Widget.SplitEase.Card" app:cardBackgroundColor="@color/glass_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:id="@+id/bills_total_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bills_total_label" android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/bills_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.SplitEase.Figure" android:textColor="@color/primary"/>
                    <TextView android:id="@+id/bills_total_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/text_secondary"/>
                    <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/bills_use_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/bills_use_total"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/bills_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/receipt_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/receipt_hint" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/receipt_debug_toggle" style="?attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receipt_debug_details" android:visibility="gone"/>
            <TextView android:id="@+id/receipt_debug" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:saveEnabled="false" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/scan_receipt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_scan"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/receipt_camera_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_camera_settings"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/receipt_cancel_capture" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_cancel_capture"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/receipt_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_retry"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_edit"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_save"/>
            <com.google.android.material.button.MaterialButton android:textColor="?attr/colorError" style="@style/Widget.SplitEase.Button.Glass" android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_delete"/>
        </LinearLayout></com.example.splitease.ui.widget.GlassCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
