<?xml version="1.0" ?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_back"/>
        <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_details" android:textAppearance="@style/TextAppearance.SplitEase.Title"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal"/>
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_load_error" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_refresh"/>
        <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.SplitEase.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/expense_title">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/expense_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:saveEnabled="false" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.SplitEase.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/expense_amount">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/expense_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:saveEnabled="false" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/payer_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_payer" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <Spinner android:id="@+id/payer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false"/>
            <TextView android:id="@+id/category_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_category" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <Spinner android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_details"/>
            <TextView android:id="@+id/participants_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_participants" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <LinearLayout android:id="@+id/participants" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/preview_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_preview_title" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <TextView android:id="@+id/shares" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_preview_hint" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
            <TextView android:id="@+id/receipt_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/receipt_title" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/receipt_detected_result" style="@style/Widget.SplitEase.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receipt_detected_label" android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:textColor="@color/text_secondary"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/receipt_detected_amount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SplitEase.Title" android:textSize="36sp" android:textColor="@color/primary"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/receipt_use_amount" style="?attr/materialButtonOutlinedStyle" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:contentDescription="@string/receipt_confirm_amount" app:cornerRadius="28dp" app:strokeColor="@color/primary" app:strokeWidth="1dp" app:icon="@drawable/ic_check" app:iconSize="28dp" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/primary" app:backgroundTint="@android:color/transparent"/>
                    </LinearLayout>
                    <TextView android:id="@+id/receipt_amount_applied" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" android:accessibilityLiveRegion="polite" android:text="@string/receipt_amount_applied" android:textAppearance="@style/TextAppearance.Material3.LabelMedium" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/receipt_evidence" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Material3.LabelMedium" android:textColor="@color/text_secondary"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_detected" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/receipt_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/receipt_hint" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/receipt_debug_toggle" style="?attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receipt_debug_details" android:visibility="gone"/>
            <TextView android:id="@+id/receipt_debug" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:saveEnabled="false" android:visibility="gone"/>
            <ImageView android:id="@+id/receipt_preview" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="12dp" android:scaleType="fitCenter" android:contentDescription="@string/receipt_image_description" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/scan_receipt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_scan"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/receipt_camera_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_camera_settings"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/receipt_cancel_capture" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_cancel_capture"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/receipt_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_view"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/receipt_remove" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_remove"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/receipt_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/receipt_retry"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_edit"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_save"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_delete"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
