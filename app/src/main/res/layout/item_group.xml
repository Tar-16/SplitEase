<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Widget.SplitEase.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_name" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_members" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <TextView android:id="@+id/initials" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_members" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <TextView android:id="@+id/created" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_name" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <TextView android:id="@+id/total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_total" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <TextView android:id="@+id/balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_your_balance" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <TextView android:id="@+id/recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/expense_latest" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_open"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
