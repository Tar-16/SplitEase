<?xml version="1.0" ?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_back"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/tab_groups" android:textAppearance="@style/TextAppearance.SplitEase.Title"/>
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_members" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_refresh"/>
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/members_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_members" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <LinearLayout android:id="@+id/members" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <include android:id="@+id/member_search" layout="@layout/view_member_search"/>
            <TextView android:id="@+id/expenses" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_expenses_placeholder" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <TextView android:id="@+id/balances" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_balances_placeholder" android:textAppearance="@style/TextAppearance.SplitEase.CardTitle"/>
            <TextView android:id="@+id/leave_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_leave_balance" android:textAppearance="@style/TextAppearance.SplitEase.Body"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/leave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/group_leave"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
