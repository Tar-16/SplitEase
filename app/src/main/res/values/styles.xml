<resources>
    <style name="Widget.SplitEase.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="TextAppearance.SplitEase.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.SplitEase.Hero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SplitEase.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.SplitEase.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.SplitEase.CardTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.SplitEase.Figure" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.SplitEase.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
    <style name="Widget.SplitEase.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <!-- Secondary action: translucent glass so only the primary action carries the teal fill. -->
    <style name="Widget.SplitEase.Button.Glass">
        <item name="backgroundTint">@color/glass_button</item>
        <item name="android:textColor">@color/glass_button_text</item>
        <item name="iconTint">@color/glass_button_text</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.SplitEase.Button.Back" parent="Widget.SplitEase.Button.Glass">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconSize">18dp</item>
    </style>
    <style name="Widget.SplitEase.Button.Round">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
    </style>
    <style name="Widget.SplitEase.Button.Round.Glass">
        <item name="backgroundTint">@color/glass_button</item>
        <item name="iconTint">@color/glass_button_text</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
